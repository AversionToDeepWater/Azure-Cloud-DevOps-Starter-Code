{
    "properties": {
        "displayName": "Deny creation of resources without tags",
        "policyType": "Custom",
        "mode": "All",
        "description": "This policy denies the creation of resources that do not have any tags assigned.",
        "metadata": {
            "version": "1.0.0",
            "category": "Tags"
        },
        "parameters": {},
        "policyRule": {
            "if": {
                "allOf": [
                    {
                        "field": "tags",
                        "exists": false
                    }
                ]
            },
            "then": {
                "effect": "deny"
            }
        }
    }
}